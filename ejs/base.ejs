<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || "CERTIFY" %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<nav class="navbar navbar-expand-lg fixed-top navbar-light px-3" id="mainNavbar">
    <a class="navbar-brand fw-bold" href="/">CERTIFY</a>

    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
        <ul class="navbar-nav">
            <% if (user) { %>
                <li class="nav-item">
                    <a class="nav-link" href="/dashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/profile">Profile</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/venues">Venues</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/logout">Logout</a>
                </li>
            <% } else { %>
                <li class="nav-item">
                    <a class="nav-link" href="/login">Login</a>
                </li>
            <% } %>
        </ul>
    </div>
</nav>

<div class="ms-1 me-1 mt-5 pt-1">
    <% if (messages) { %>
        <% Object.keys(messages).forEach(category => { %>
            <% messages[category].forEach(message => { %>
                <div class="alert alert-<%= category %>">
                    <%= message %>
                </div>
            <% }) %>
        <% }) %>
    <% } %>
</div>

<div class="content-wrapper">
    <div class="container">
        <%- body %>
    </div>
</div>

<footer class="footer">
    <div class="contain">
        <div class="row">
            <div class="footer-col text-left">
                <h4>
                    © 2025 Certify Philippines.
                    Certify® is a registered trademark.
                </h4>
            </div>

            <div class="footer-col links-right">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/dashboard">Dashboard</a></li>
                    <li><a href="/profile">Profile</a></li>
                    <li><a href="/venues">Venues</a></li>
                </ul>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
window.onscroll = function () {
    const navbar = document.getElementById("mainNavbar");
    if (window.scrollY > 50) {
        navbar.classList.add("navbar-transparent");
    } else {
        navbar.classList.remove("navbar-transparent");
    }
};
</script>

</body>
</html>
